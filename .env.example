# Simple Cloud Mining - environment template
#
# Copy this file to .env.local and fill in your values, or let the wizard do it:
#   npm run setup
#
# Only NEXT_PUBLIC_* values are sent to the browser. Treat everything else as a
# secret. Never commit .env.local.

# --- Supabase (Project Settings > API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Bypasses row level security. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---------------------------------------------------------------------
# The public address of the app. Used for referral links and the CoinPayments
# return URL. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cron ---------------------------------------------------------------------
# Guards /api/cron/*. Vercel sends this as a Bearer token on scheduled runs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=change-me

# --- CoinPayments (Account > API Keys) ---------------------------------------
# Required for checkout (both Gateway and API modes).
COINPAYMENTS_MERCHANT_ID=your-merchant-id
COINPAYMENTS_IPN_SECRET=your-ipn-secret
# Only needed for coin_mode=api and for automated payouts.
COINPAYMENTS_PRIVATE_KEY=
COINPAYMENTS_PUBLIC_KEY=

# --- Optional -----------------------------------------------------------------
# Salt for hashing IP addresses in the anti-fraud telemetry. Falls back to the
# service role key when empty. Set a random value in production.
RISK_SALT=
# From address shown on gateway emails when coin_email=admin.
SMTP_SENDER=
# AI keys power the admin "plan assistant". The feature is hidden without them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PLAN_AI_MODEL=
