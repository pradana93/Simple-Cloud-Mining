# Simple Cloud Mining - environment template
#
# Copy this file to .env.local and fill in your values, or let the wizard do it:
#   npm run setup
#
# Only NEXT_PUBLIC_* values are sent to the browser. Treat everything else as a
# secret. Never commit .env.local.

# --- Supabase (Project Settings > API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Bypasses row level security. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---------------------------------------------------------------------
# The public address of the app. Used for referral links and the CryptAPI
# callback URL. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cron ---------------------------------------------------------------------
# Guards /api/cron/*. Vercel sends this as a Bearer token on scheduled runs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=change-me

# --- CryptAPI -----------------------------------------------------------------
# Public receiving addresses only. No account, API key, or private key is
# needed. Deposits forward straight to these wallets. These values override the
# addresses saved in Admin > Settings. USDT is TRC20 and needs its own address.
CRYPTAPI_BTC_ADDRESS=
CRYPTAPI_LTC_ADDRESS=
CRYPTAPI_DOGE_ADDRESS=
CRYPTAPI_ETH_ADDRESS=
CRYPTAPI_TRX_ADDRESS=
CRYPTAPI_USDT_TRC20_ADDRESS=

# --- Observability ------------------------------------------------------------
# Sentry DSN. The public copy is safe in the browser; the server copy enables
# server and edge events. Leave both empty to disable Sentry.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Needed only for source-map upload during builds.
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_TRACES_SAMPLE_RATE=0.05

# Slack or Discord incoming webhook for money and ledger alerts.
ALERT_WEBHOOK_URL=

# --- Backups ------------------------------------------------------------------
# Personal access token for the Supabase Management API (backup posture check).
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
# At least 32 characters. Store it in a secret manager, separately from backups.
BACKUP_ENCRYPTION_KEY=
# Optional output directory. Defaults to ./backups (git-ignored).
BACKUP_DIR=
# Optional offsite copy. The script PUTs the encrypted file to this URL.
BACKUP_UPLOAD_URL=
BACKUP_UPLOAD_TOKEN=

# --- End-to-end tests ---------------------------------------------------------
# Playwright reads these from .env.local. Signed-in tests are skipped without
# credentials. Never use a real funded account in CI.
E2E_BASE_URL=
E2E_USERNAME=
E2E_PASSWORD=
E2E_EXPECT_ADMIN=0

# --- Optional -----------------------------------------------------------------
# Salt for hashing IP addresses in the anti-fraud telemetry. Falls back to the
# service role key when empty. Set a random value in production.
RISK_SALT=
# From address for outbound mail.
SMTP_SENDER=
# AI keys power the admin "plan assistant". The feature is hidden without them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PLAN_AI_MODEL=
